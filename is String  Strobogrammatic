import java.util.*;
import java.util.Scanner;
class Stroprob{
    public static boolean isStroprob(Map<Character,Character> map,String s){
        int i = 0, j = s.length()-1;
        while(i<=j){
            char t = s.charAt(i);
            char r = s.charAt(j);
            if(map.containsKey(t)){
                if(map.get(t) != r){
                    return false;
                }
                else{
                    i++;
                    j--;
                }
           
            }else {
                 return false;
            }
        }
    return true;
    }
    public static void main(String[] args){
        Map<Character,Character> map = new HashMap<>();
        map.put('0','0');
        map.put('1','1');
        map.put('8','8');
        map.put('6','9');
        map.put('9','6');
        //String s = "198861";
        Scanner input =  new Scanner(System.in);
        String s = input.nextLine();
        System.out.println(isStroprob(map,s));
    }
}
